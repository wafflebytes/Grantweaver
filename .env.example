# ── Slack ──────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...            # OAuth & Permissions → Bot User OAuth Token
SLACK_SIGNING_SECRET=...            # Basic Information → Signing Secret
SLACK_APP_TOKEN=xapp-...            # Basic Information → App-Level Tokens (connections:write) — Socket Mode only
SOCKET_MODE=true                    # true locally, false on Railway (HTTP mode)

# ── LLM (OpenAI-compatible; provider picked by scripts/llm-bakeoff.mjs) ─
# Gemini free tier: https://generativelanguage.googleapis.com/v1beta/openai/
# NVIDIA NIM:       https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...
LLM_MODEL=minimaxai/minimax-m3
LLM_MAX_TOKENS=8000
# Fallback (different provider so one outage can't take both down — swap by env alone)
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=AIza...
LLM_FALLBACK_MODEL=gemini-2.5-flash

# ── Data ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grantweaver

# ── MCP ────────────────────────────────────────────────────────────────
MCP_SHARED_SECRET=change-me-long-random          # bearer for grantweaver-mcp HTTP
GRANTSGOV_MCP_TRANSPORT=stdio                    # stdio | http
GRANTSGOV_MCP_URL=http://localhost:7801/mcp      # used when transport=http
GRANTWEAVER_MCP_PORT=7802

# ── Ops ────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info                                   # info | debug
BUILD_SHA=dev

# ── Phase 2 ────────────────────────────────────────────────
WEB_LINK_SECRET=                                 # 64-char hex — magic links for the web evidence viewer
APP_BASE_URL=                                    # e.g. https://grantweaver-production.up.railway.app
HARVEST_LLM=true                                 # false → heuristic-only evidence harvesting (NIM saver)
SIMULATE_ALLOWED_USERS=                          # comma-separated user ids allowed to run /grantweaver simulate (empty = any)

# ── Seeding (separate seeder app) ───────────────────────────────
SEED_BOT_TOKEN=xoxb-...
SEED_USER_TOKENS=xoxp-...,xoxp-...               # legacy comma list (scripts/seed-demo.mjs)
# scripts/seed-riverbend.mjs wants JSON keyed by persona handle instead —
# personas without a token here fall back to bot-posted + username override:
# SEED_USER_TOKENS={"maya":"xoxp-...","dre":"xoxp-...","priya":"xoxp-...","sam":"xoxp-...","jo":"xoxp-..."}
